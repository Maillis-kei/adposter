# Google GenAI (Gemini & Imagen 3) API Key
GEMINI_API_KEY=your_gemini_api_key_here

# TypeSafe AI Jev Guardrail API Key
TYPESAFE_API_KEY=your_typesafe_api_key_here

# Gmail Dispatcher Settings (SMTP)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_app_password
RECEIVER_EMAILS=pastor@example.com,member@example.com

# Google Drive API Settings (Optional)
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here
SERVICE_ACCOUNT_JSON_PATH=service_account.json

# Optional: Override church contact display (true/false)
SHOW_CHURCH_CONTACT=false
